// Nextflow configuration template for GW-RePO.
// Use with:  nextflow run <pipeline> -c gwrepo.config
// then:      python /path/to/lineage-import/submit_lineage.py
//            python /path/to/co2-import/submit_co2.py            (if nf-co2footprint enabled below)
//
// No custom Nextflow plugin needed -- `tower {}` is a config block built into
// Nextflow core; it streams workflow / process resource-metric data to the GW-RePO
// API as the run proceeds. `institute` / `dataSizeTag` (gw-repo-specific, no slot
// in the tower protocol itself) are encoded as a path-segment prefix on the
// endpoint -- change the '/DKFZ/mixed' below to your institute and data-size tag.

tower {
    enabled     = true
    endpoint    = 'http://localhost:80/DKFZ'
    accessToken = System.getenv('TOWER_ACCESS_TOKEN')
}

// File provenance (input/output checksums), read post-run by lineage-import/submit_lineage.py.
lineage {
    enabled = true
}

plugins {
    id 'nf-co2footprint'     // CO2 + energy (optional; imported after the run)
}

// CO2 footprint (optional). The provenance file co2-import's importer reads is on
// by default; the summary file (car-km / tree-sequestration figures) is not.
co2footprint {
    location = 'DE'                       // carbon-intensity zone
    emApiKey = secrets.EM_API_KEY         // Electricity Maps key for live CI (optional)
    pue      = 1.3                        // data-centre power usage effectiveness (optional)
    summary { enabled = true }
}

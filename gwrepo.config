// Nextflow configuration template for GW-RePO.
// Use with:  nextflow run <pipeline> -c gwrepo.config
// then, for CO2:  python /path/to/co2-import/submit_co2.py

plugins {
    id 'nf-gwrepo'           // streams workflow / process / file provenance to the API
    id 'nf-co2footprint'     // CO2 + energy (optional; imported after the run)
}

gwrepo {
    endpoint    = 'http://localhost:80'   // GW-RePO API base URL
    apiKey      = secrets.GWREPO_API_KEY  // or the GWREPO_API_KEY env var
    institute   = 'DKFZ'
    dataSizeTag = 'mixed'                 // small | medium | large | mixed
}

// CO2 footprint (optional). The provenance file nf-gwrepo's importer reads is on by
// default; the summary file (car-km / tree-sequestration figures) is not.
co2footprint {
    location = 'DE'                       // carbon-intensity zone
    emApiKey = secrets.EM_API_KEY         // Electricity Maps key for live CI (optional)
    pue      = 1.3                        // data-centre power usage effectiveness (optional)
    summary { enabled = true }
}
